<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.Reflection?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Ellipse?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0"
      prefWidth="600.0" spacing="20.0" style="-fx-background-color: BLACK;" xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lab9exe.Lab9Controller">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <StackPane prefHeight="150.0" prefWidth="200.0">
        <Ellipse radiusX="110.0" radiusY="70.0" stroke="HOTPINK" strokeType="INSIDE" strokeWidth="2.0">
            <effect>
                <Reflection fraction="0.2" topOffset="1.0"/>
            </effect>
        </Ellipse>
        <Text fx:id="text" fill="WHITE" onMouseClicked="#handleClick" onMouseEntered="#handleMouseEntered"
              strokeType="OUTSIDE" strokeWidth="0.0" text="I ❤ UI" textAlignment="CENTER">
            <font>
                <Font name="Arial Bold" size="24.0"/>
            </font>
        </Text>
    </StackPane>
    <Text fx:id="invalidationStatusText" fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0"
          text="Animation status: STOPPED"/>
    <Text fx:id="changeStatusText" fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="Now STOPPED"/>
    <HBox alignment="TOP_CENTER" prefHeight="100.0" prefWidth="200.0">
        <TextField fx:id="input1"/>
        <TextField fx:id="input2"/>
    </HBox>
</VBox>
